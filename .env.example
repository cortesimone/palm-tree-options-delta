# Alpaca API credentials
# Secrets live in secrets/.env — copy your service-account JSON there.
# Environment-specific overrides go in .env.local or .env.production.
# secrets/ and .env files are gitignored — do not commit them.

# Alpaca API credentials (set in secrets/.env or .env.{env})
ALPACA_API_KEY=xxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

